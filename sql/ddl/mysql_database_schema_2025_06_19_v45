SELECT permanent.permanent_id, permanent.card_name, mana_cost.mana_cost, supertype.supertype, type_line.type_line, subtype.subtype, expansion_symbol.expansion_symbol, rarity.rarity, text_box.text_box, flavor_text.flavor_text, creature.punch AS "power", creature.toughness, planeswalker.starting_loyalty, artist_information.artist_information, permanent.collectors_number
FROM permanent
LEFT JOIN creature
ON permanent.permanent_id = creature.creature_fk
LEFT JOIN planeswalker
ON permanent.permanent_id = planeswalker.planeswalker_fk
LEFT JOIN permanent_mana_cost
ON permanent.permanent_id = permanent_mana_cost.permanent_fk
LEFT JOIN mana_cost
ON permanent_mana_cost.mana_cost_fk = mana_cost.mana_cost_id
LEFT JOIN permanent_supertype
ON permanent_supertype.permanent_fk = permanent.permanent_id
LEFT JOIN supertype
ON permanent_supertype.supertype_fk = supertype.supertype_id
LEFT JOIN type_line
ON permanent.permanent_id = type_line.type_line_id
LEFT JOIN permanent_subtype
ON permanent_subtype.permanent_fk = permanent.permanent_id
LEFT JOIN subtype
ON permanent_subtype.subtype_fk = subtype.subtype_id
LEFT JOIN expansion_symbol
ON permanent.expansion_symbol_fk = expansion_symbol.expansion_symbol_id
LEFT JOIN rarity
ON permanent.rarity_fk = rarity.rarity_id
LEFT JOIN text_box
ON permanent.permanent_id = text_box.text_box_id
LEFT JOIN flavor_text
ON permanent.permanent_id = flavor_text.flavor_text_id
LEFT JOIN artist_information
ON permanent.artist_information_fk = artist_information.artist_information_id;