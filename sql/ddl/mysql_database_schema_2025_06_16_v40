CREATE TABLE permanent (
	permanent_id INT AUTO INCREMENT,
	card_name VARCHAR(),
	-- mana_cost VARCHAR(),
	-- supertype VARCHAR(),
	type_line_fk VARCHAR(),
	-- subtype VARCHAR(),
	expansion_symbol_fk VARCHAR(),
	rarity_fk VARCHAR(),
	-- text_box VARCHAR(),
	-- flavor_text VARCHAR(),
	-- power INT,
	-- toughness INT,
	-- starting_loyalty INT,
	artist_information_fk VARCHAR(),
	collectors_number INT,
	PRIMARY KEY (permanent_id),
	FOREIGN KEY (type_line_fk) REFERENCES type_line(type_line_id),
	FOREIGN KEY (expansion_symbol_fk) REFERENCES expansion_symbol(expansion_symbol_id),
	FOREIGN KEY (rarity_fk) REFERENCES rarity(rarity_id),
	FOREIGN KEY (artist_information_fk) REFERENCES artist_information(artist_information_id)
);
-- PARENT TABLE FOR COMPLETE LIST OF MANA COSTS
CREATE TABLE mana_cost (
	mana_cost_id INT AUTO INCREMENT,
	mana_cost VARCHAR(),
	PRIMARY KEY (mana_cost_id)
);
-- PARENT TABLE FOR ALL SUPERTYPES
CREATE TABLE supertype (
	supertype_id INT AUTO INCREMENT,
	supertype VARCHAR(),
	PRIMARY KEY (supertype_id)
);
-- LINKING TABLE CONNECTING PERMANENT TO ONE SUPERTYPE
CREATE TABLE permanent_supertype (
	permanent_fk INT,
	supertype_fk INT,
	PRIMARY KEY (permanent_fk),
	FOREIGN KEY (permanent_fk) REFERENCES permanent(permanent_id),
	FOREIGN KEY (supertype_fk) REFERENCES supertype(supertype_id)
);
-- PARENT TABLE FOR ALL TYPES
CREATE TABLE type_line (
	type_line_id INT AUTO INCREMENT,
	type_line VARCHAR(),
	PRIMARY KEY (type_line_id)
);
-- PARENT TABLE FOR ALL SUBTYPES
CREATE TABLE subtype (
	subtype_id INT AUTO INCREMENT,
	subtype VARCHAR(),
	PRIMARY KEY (subtype_id)
);
-- LINKING TABLE CONNECTING PERMANENT TO MULTIPLE SUBTYPES
CREATE TABLE permanent_subtype (
	subtype_fk,
	permanent_fk,
	PRIMARY KEY (subtype_fk, permanent_fk)
	FOREIGN KEY (subtype_fk) REFERENCES subtype(subtype_id),
	FOREIGN KEY (permanent_fk) REFERENCES permanent(permanent_id)
);
-- PARENT TABLE FOR ALL EXPANSIONS
CREATE TABLE expansion_symbol (
	expansion_symbol_id INT AUTO INCREMENT,
	expansion_symbol VARCHAR(),
	PRIMARY KEY (expansion_symbol_id)
);

-- PARENT TABLE FOR ALL RARITIES
CREATE TABLE rarities (
	rarities_id INT AUTO INCREMENT,
	rarity VARCHAR(),
	PRIMARY KEY (rarities_id)
);

-- PARENT TABLE FOR ALL ARTIST INFORMATION
CREATE TABLE artist_information (
	artist_information_id INT AUTO INCREMENT,
	artist_information VARCHAR()
	PRIMARY KEY (artist_information_id)
);
-- LINKING TABLE CONNECTING NONCREATURE INFORMATION TO PERMANENT
CREATE TABLE noncreature (
	noncreature_fk INT,
	mana_cost_fk INT,
	PRIMARY KEY (noncreature_fk),
	FOREIGN KEY (noncreature_fk) REFERENCES permanent(permanent_id),
	FOREIGN KEY (mana_cost_fk) REFERENCES mana_cost(mana_cost_id)
);
-- LINKING TABLE CONNECTING CREATURE INFORMATION TO PERMANENT
CREATE TABLE creature (
	creature_fk INT,
	mana_cost_fk INT,
	power INT,
	toughness INT,
	PRIMARY KEY (creature_fk),
	FOREIGN KEY (creature_fk) REFERENCES permanent(permanent_id),
	FOREIGN KEY (mana_cost_fk) REFERENCES mana_cost(mana_cost_id)
);
-- LINKING TABLE CONNECTING PLANESWALKER INFORMATION TO PERMANENT
CREATE TABLE planeswalker (
	planeswalker_fk INT,
	mana_cost_fk INT,
	starting_loyalty INT,
	PRIMARY KEY (planeswalker_fk),
	FOREIGN KEY (planeswalker_fk) REFERENCES permanent(permanent_id),
	FOREIGN KEY (mana_cost_fk) REFERENCES mana_cost(mana_cost_id)
);