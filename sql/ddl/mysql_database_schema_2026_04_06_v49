SELECT permanent.permanent_id, permanent.card_name, mana_cost.mana_cost, supertype.supertype, subtype.subtype, expansion_symbol.expansion_symbol, rarity.rarity, text_box.text_box, flavor_text.flavor_text, creature.punch AS "power", creature.toughness, planeswalker.starting_loyalty, artist_information.artist_information, permanent.collectors_number
FROM permanent
LEFT JOIN permanent_junction_mana_cost
ON permanent.permanent_id = permanent_junction_mana_cost.permanent_id
LEFT JOIN mana_cost
ON permanent_junction_mana_cost.mana_cost_id = mana_cost.mana_cost_id
LEFT JOIN permanent_junction_supertype
ON permanent.permanent_id = permanent_junction_supertype.permanent_id
LEFT JOIN supertype
ON permanent_junction_supertype.supertype_id = supertype.supertype_id
LEFT JOIN permanent_junction_subtype
ON permanent.permanent_id = permanent_junction_subtype.permanent_id
LEFT JOIN subtype
ON permanent_junction_subtype.subtype_id = subtype.subtype_id
LEFT JOIN expansion_symbol
ON permanent.expansion_symbol = expansion_symbol.expansion_symbol_id
LEFT JOIN rarity
ON permanent.rarity = rarity.rarity_id
LEFT JOIN permanent_junction_text_box
ON permanent.permanent_id = permanent_junction_text_box.permanent_id
LEFT JOIN text_box
ON permanent_junction_text_box.text_box_id = text_box.text_box_id
LEFT JOIN permanent_junction_flavor_text
ON permanent.permanent_id = permanent_junction_flavor_text.permanent_id
LEFT JOIN flavor_text
ON permanent_junction_flavor_text.flavor_text_id = flavor_text.flavor_text_id
LEFT JOIN permanent_junction_creature
ON permanent.permanent_id = permanent_junction_creature.permanent_id
LEFT JOIN creature
ON permanent_junction_creature.creature_id = creature.creature_id
LEFT JOIN permanent_junction_planeswalker
ON permanent.permanent_id = permanent_junction_creature.permanent_id
LEFT JOIN planeswalker
ON permanent_junction_planeswalker.planeswalker_id = planeswalker.planeswalker_id
LEFT JOIN artist_information
ON permanent.artist_information = artist_information.artist_information_id;